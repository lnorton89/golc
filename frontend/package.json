{
  "name": "golc-desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:resize": "playwright test e2e/resize.spec.ts",
    "docs:screenshots": "playwright test e2e/desktop-view-docs.spec.ts --workers=1",
    "generate:design-system": "node scripts/design-system/generate.mjs",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "lucide-react": "^1.27.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^29.1.1",
    "postcss": "8.5.22",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  }
}
